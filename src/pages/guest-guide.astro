---
import '../styles/global.css';

// 手順カード用の小さなアイコン（Lucide）
const stepIcon = {
  calendar: '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M16 2v4"/>',
  tap: '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 10a7 7 0 0 1 14 0v4a3 3 0 0 1-3 3h-2"/><path d="m9 13-1 9"/><path d="m14 13 1 9"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  key: '<circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/>',
  check: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/>',
};
const steps = [
  { icon: 'calendar', title: '練習を選ぶ', text: 'トップページの「活動予定」から、参加したい練習を選びます。日程・場所・空き状況が確認できます。' },
  { icon: 'tap', title: '「ゲストとして参加登録」を押す', text: '選んだ練習の「ゲストとして参加登録」ボタンから、登録画面へ進みます。' },
  { icon: 'pen', title: '必要事項を入力', text: 'お名前（フルネーム）・ふりがな・メールアドレスを入力します。' },
  { icon: 'key', title: '作成方法を選ぶ', text: 'メールアドレス＋パスワード、または Google アカウントで登録できます。' },
  { icon: 'check', title: '完了', text: '認証が終わると、選んだ練習に自動で参加登録されます。当日お待ちしています！' },
];
const canDo = [
  '練習予定（日程・場所・空き状況）の確認',
  '練習への参加登録・取り消し',
  '管理者へのメッセージ（ご質問・ご相談）',
];
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ゲスト参加の登録方法｜AKI PICKLES</title>
  <meta name="description" content="AKI PICKLES のホームページから、ゲストとして練習に参加申し込みをする方法と、アプリ『AKI PICKLES connect』のご案内です。">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body style="background: #FAF4E8;">

<!-- ヘッダー -->
<header style="position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(250, 244, 232, 0.92); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(224, 96, 74, 0.14);">
  <div style="max-width: 1080px; margin: 0 auto; padding: 0 20px; height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
    <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
      <img src="/logo.webp" alt="AKI PICKLES" style="height: 42px; width: auto; display: block; mix-blend-mode: multiply;">
      <span style="font-size: 11px; font-weight: 500; color: #A08F78; letter-spacing: 0.1em;">あきぴっくるず</span>
    </a>
    <a href="/" style="font-size: 13px; font-weight: 600; color: #E0604A; text-decoration: none; display: flex; align-items: center; gap: 6px;">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5 M11 6l-6 6 6 6"></path></svg>
      トップへ戻る
    </a>
  </div>
</header>

<article style="padding: 110px 20px 80px;">
  <div style="max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px;">

    <!-- タイトル -->
    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <time style="font-family: Jost, sans-serif; font-size: 13px; font-weight: 500; color: #A08F78; letter-spacing: 0.06em;">2026.10.23</time>
        <span style="font-size: 11px; font-weight: 700; color: #A08F78; background: #F3EBDC; padding: 3px 10px; border-radius: 999px; letter-spacing: 0.08em;">お知らせ</span>
      </div>
      <h1 style="margin: 0; font-size: clamp(22px, 5vw, 30px); font-weight: 900; color: #33291F; line-height: 1.5;">
        ゲスト参加の登録方法・アプリについて
      </h1>
      <p style="margin: 0; font-size: 15px; line-height: 2; color: #6B5F4E; font-weight: 500;">
        公式サイトの「活動予定」から、どなたでも練習の予定を確認し、ゲストとして参加の申し込みができるようになりました。はじめての方も、スマホから数分で登録できます。
      </p>
    </div>

    <!-- アプリ説明 -->
    <section style="background: #FFFFFF; border-radius: 16px; padding: 28px 26px; border: 1px solid rgba(160, 143, 120, 0.16); display: flex; flex-direction: column; gap: 14px;">
      <h2 style="margin: 0; font-size: 18px; font-weight: 800; color: #33291F;">AKI PICKLES connect とは？</h2>
      <p style="margin: 0; font-size: 14.5px; line-height: 1.95; color: #4A3F34;">
        「AKI PICKLES connect」は、クラブの練習予定の確認・参加登録などができる専用アプリ（Webアプリ）です。インストール不要で、スマホのブラウザからそのまま使えます。
        ゲストとして登録すると、練習予定の確認・参加登録と、管理者へのお問い合わせができます。
      </p>
      <!-- スクショ追加位置：アプリのホーム/活動予定画面など <img src="/guide-app.png" style="width:100%; border-radius:12px; border:1px solid rgba(160,143,120,0.2);" alt="AKI PICKLES connect の画面"> -->
    </section>

    <!-- 登録手順 -->
    <section style="display: flex; flex-direction: column; gap: 16px;">
      <h2 style="margin: 0; font-size: 18px; font-weight: 800; color: #33291F;">ゲスト登録の手順</h2>
      <ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px;">
        {steps.map((s, i) => (
          <li style="display: flex; gap: 14px; align-items: flex-start; background: #FFFFFF; border: 1px solid rgba(160, 143, 120, 0.16); border-radius: 14px; padding: 18px 18px;">
            <span style="flex: none; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 12px; background: #FBEAE4; color: #E0604A; position: relative;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={stepIcon[s.icon]} />
              <span style="position: absolute; top: -6px; left: -6px; width: 20px; height: 20px; border-radius: 999px; background: #E0604A; color: #FFFFFF; font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center;">{i + 1}</span>
            </span>
            <div style="display: flex; flex-direction: column; gap: 3px; min-width: 0;">
              <span style="font-size: 15px; font-weight: 800; color: #33291F;">{s.title}</span>
              <span style="font-size: 13.5px; line-height: 1.85; color: #6B5F4E;">{s.text}</span>
            </div>
          </li>
        ))}
      </ol>
      <p style="margin: 0; font-size: 12.5px; color: #A08F78; line-height: 1.8;">
        ※ 練習日の直前（5日前〜）になると参加登録ができます。少し先の練習は、登録後そのまま予定として確認できます。
      </p>
    </section>

    <!-- できること -->
    <section style="background: #FFFFFF; border-radius: 16px; padding: 28px 26px; border: 1px solid rgba(160, 143, 120, 0.16); display: flex; flex-direction: column; gap: 14px;">
      <h2 style="margin: 0; font-size: 18px; font-weight: 800; color: #33291F;">ゲストでできること</h2>
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px;">
        {canDo.map((t) => (
          <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 14.5px; line-height: 1.8; color: #4A3F34;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2E9E6B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex: none; margin-top: 2px;"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{t}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- CTA -->
    <div style="display: flex; justify-content: center;">
      <a href="/#schedule" class="btn-primary" style="display: inline-flex; align-items: center; gap: 9px; font-size: 15px; font-weight: 800; color: #FFFFFF; background: #E0604A; text-decoration: none; padding: 15px 30px; border-radius: 999px; box-shadow: 0 6px 18px rgba(224, 96, 74, 0.32);">
        練習一覧を見て申し込む
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14 M13 6l6 6-6 6"></path></svg>
      </a>
    </div>

    <!-- 戻るリンク -->
    <a href="/news" style="display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: #A08F78; text-decoration: none;">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5 M11 6l-6 6 6 6"></path></svg>
      お知らせ一覧へ
    </a>
  </div>
</article>

<!-- フッター -->
<footer style="background: #33291F; color: #D8C7A8; padding: 28px 20px;">
  <div style="max-width: 1080px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
    <span style="font-size: 11.5px; color: #A08F78;">© 2026 AKI PICKLES. All rights reserved.</span>
    <a href="/" style="font-size: 13px; font-weight: 600; color: #D8C7A8; text-decoration: none;">トップへ戻る</a>
  </div>
</footer>

</body>
</html>
