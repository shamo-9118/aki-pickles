<script>
  // ローディング
  const loader = document.getElementById('loader');
  if (loader) {
    setTimeout(() => { loader.style.opacity = '0'; }, 2300);
    setTimeout(() => { loader.style.display = 'none'; }, 2900);
  }

  // ヒーロースライドショー
  const slides = document.querySelectorAll('.hero-slide');
  let heroIndex = 0;
  if (slides.length > 1) {
    setInterval(() => {
      slides[heroIndex].classList.remove('active');
      heroIndex = (heroIndex + 1) % slides.length;
      slides[heroIndex].classList.add('active');
    }, 5000);
  }

  // モバイルメニュー
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const desktopNav = document.getElementById('desktop-nav');
  const menuOverlay = document.getElementById('menu-overlay');

  const OPEN_PATH = "M6 6l12 12 M6 18L18 6";
  const CLOSE_PATH = "M4 7h16 M4 12h16 M4 17h16";

  // メニューの開閉（オーバーレイ表示＋背景スクロール固定）
  function setMenu(open) {
    if (!mobileMenu) return;
    mobileMenu.classList.toggle('open', open);
    menuOverlay?.classList.toggle('open', open);
    document.body.classList.toggle('menu-open', open);
    if (menuIcon) menuIcon.setAttribute('d', open ? OPEN_PATH : CLOSE_PATH);
    if (menuBtn) menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function updateLayout() {
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    if (menuBtn) menuBtn.style.display = isMobile ? 'flex' : 'none';
    if (desktopNav) desktopNav.style.display = isMobile ? 'none' : 'flex';
    // PC幅になったら必ず閉じる
    if (!isMobile) setMenu(false);
  }

  updateLayout();
  window.matchMedia('(max-width: 767px)').addEventListener('change', updateLayout);

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => setMenu(!mobileMenu.classList.contains('open')));
  }
  // オーバーレイをタップで閉じる
  menuOverlay?.addEventListener('click', () => setMenu(false));
  // メニュー内のリンクをタップしたら閉じる
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });
  // Esc キーで閉じる
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

  // IG スライダー（モバイルのみ）
  (function() {
    const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
    const inner = document.getElementById('ig-inner');
    const prevBtn = document.getElementById('ig-prev');
    const nextBtn = document.getElementById('ig-next');
    if (!inner || !prevBtn || !nextBtn) return;
    let idx = 0;
    const total = inner.children.length;
    function getOffset() {
      const c0 = inner.children[0];
      const c1 = inner.children[1];
      if (c0 && c1) return c1.getBoundingClientRect().left - c0.getBoundingClientRect().left;
      return c0 ? c0.offsetWidth + 12 : 0;
    }
    function update() {
      if (!isMobile()) { inner.style.transform = ''; return; }
      inner.style.transform = `translateX(-${idx * getOffset()}px)`;
      prevBtn.style.opacity = idx === 0 ? '0.3' : '1';
      nextBtn.style.opacity = idx >= total - 1 ? '0.3' : '1';
    }
    prevBtn.addEventListener('click', () => { if (isMobile() && idx > 0) { idx--; update(); } });
    nextBtn.addEventListener('click', () => { if (isMobile() && idx < total - 1) { idx++; update(); } });
    window.addEventListener('resize', () => { idx = 0; update(); });
    update();
  })();

  // FAQ アコーディオン（排他制御・アニメーション）
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    const btn = item.querySelector('.faq-summary');
    btn?.addEventListener('click', () => {
      const isOpen = item.classList.contains('is-open');
      faqItems.forEach(i => i.classList.remove('is-open'));
      if (!isOpen) item.classList.add('is-open');
    });
  });

  // 活動場所：左上のスライド切替＋スワイプで、枠はそのまま中身だけ切り替える
  (() => {
    const tabsEl = document.getElementById('place-tabs');
    const indicator = document.getElementById('place-tab-indicator');
    const track = document.getElementById('place-track');
    const viewport = document.getElementById('place-viewport');
    if (!tabsEl || !indicator || !track || !viewport) return;
    const tabs = Array.from(tabsEl.querySelectorAll('.place-tab'));
    const total = tabs.length;
    if (total === 0) return;
    let idx = 0;

    function moveIndicator() {
      const btn = tabs[idx];
      indicator.style.width = btn.offsetWidth + 'px';
      indicator.style.transform = 'translateX(' + btn.offsetLeft + 'px)';
    }
    function select(i) {
      idx = Math.max(0, Math.min(total - 1, i));
      track.style.transform = 'translateX(' + (-idx * 100) + '%)';
      tabs.forEach((t, n) => {
        t.classList.toggle('active', n === idx);
        t.setAttribute('aria-selected', n === idx ? 'true' : 'false');
      });
      moveIndicator();
    }

    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));

    // スワイプで切り替え（モバイル）
    let startX = 0, startY = 0, swiping = false;
    viewport.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX; startY = e.touches[0].clientY; swiping = true;
    }, { passive: true });
    viewport.addEventListener('touchend', (e) => {
      if (!swiping) return;
      swiping = false;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      // 横方向のはっきりしたスワイプのみ（縦スクロールを邪魔しない）
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
        select(idx + (dx < 0 ? 1 : -1));
      }
    }, { passive: true });

    // 初期位置・リサイズ時にインジケーターを合わせる
    requestAnimationFrame(moveIndicator);
    window.addEventListener('resize', moveIndicator);
  })();
</script>

</body>
