<section id="schedule" style="padding: 84px 20px; background: #FFFDF8;">
  <div style="max-width: 880px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px;">
    <div style="display: flex; flex-direction: column; gap: 8px;">
      <span style="font-family: Jost, sans-serif; font-weight: 600; font-size: 12px; letter-spacing: 0.3em; color: #E0604A;">SCHEDULE</span>
      <h2 style="margin: 0; font-size: 27px; font-weight: 900; color: #33291F;">活動予定</h2>
    </div>

    <!-- 練習予定（アプリから自動表示・ゲスト参加受付中） -->
    <div id="live-schedule" style="display: none; flex-direction: column; gap: 14px;">
      <p style="margin: 0; font-size: 13px; color: #A08F78; line-height: 1.8;">
        下の「ゲストとして参加登録」から、はじめての方も参加できます。アカウントを作ると練習予定の確認と参加登録ができます。
      </p>
      <div id="live-schedule-list" style="display: flex; flex-direction: column; gap: 12px;"></div>
    </div>
  </div>
</section>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, CONNECT_URL }}>
  // アプリのSupabaseから、今日以降の練習予定を匿名で読んで表示する。
  // 返るのは安全な項目だけ（日付・タイトル・時間・場所・定員・参加人数）。氏名は含まれない。
  (async () => {
    if (!SUPABASE_URL || !SUPABASE_ANON_KEY) return
    const wrap = document.getElementById("live-schedule")
    const list = document.getElementById("live-schedule-list")
    if (!wrap || !list) return

    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]))
    const WD = ["日", "月", "火", "水", "木", "金", "土"]
    const fmtDate = (ymd) => {
      const [y, m, d] = ymd.split("-").map(Number)
      const wd = new Date(y, m - 1, d).getDay()
      return `${m}月${d}日（${WD[wd]}）`
    }
    const hhmm = (t) => (t ? String(t).slice(0, 5) : "")

    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/public_schedule`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
        },
        body: "{}",
      })
      if (!res.ok) return
      const rows = await res.json()
      if (!Array.isArray(rows) || rows.length === 0) return

      // Lucide（shadcnと同じアイコンセット）のインラインSVG
      const svg = (inner) =>
        `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none">${inner}</svg>`
      const IC_CAL = svg('<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M16 2v4"/>')
      const IC_CLOCK = svg('<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>')
      const IC_PIN = svg('<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>')
      const IC_USERS = svg('<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>')
      const IC_USERPLUS = svg('<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/>')

      list.innerHTML = rows
        .slice(0, 8)
        .map((e) => {
          const cap =
            e.max_participants != null
              ? `${e.participant_count ?? 0} / ${e.max_participants} 名`
              : `${e.participant_count ?? 0} 名参加`
          const time = [hhmm(e.start_time), hhmm(e.end_time)].filter(Boolean).join(" – ")
          const guestUrl = `${CONNECT_URL}/guest-signup?event=${encodeURIComponent(e.id)}`
          return `
            <div style="border: 1px solid rgba(160,143,120,0.22); border-radius: 16px; background: #FFFFFF; padding: 18px 20px; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 1px 3px rgba(51,41,31,0.04);">
              <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px;">
                <span style="display: inline-flex; align-items: center; gap: 6px; background: rgba(224,96,74,0.1); color: #E0604A; font-size: 13px; font-weight: 800; padding: 4px 11px; border-radius: 999px;">${IC_CAL}${esc(fmtDate(e.date))}</span>
                <span style="font-size: 16px; font-weight: 800; color: #33291F;">${esc(e.title)}</span>
              </div>
              <div style="display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: #6B5F4E;">
                ${time ? `<span style="display: inline-flex; align-items: center; gap: 6px;">${IC_CLOCK}${esc(time)}</span>` : ""}${e.location ? `<span style="display: inline-flex; align-items: center; gap: 6px;">${IC_PIN}${esc(e.location)}</span>` : ""}<span style="display: inline-flex; align-items: center; gap: 6px;">${IC_USERS}${esc(cap)}</span>
              </div>
              <a href="${guestUrl}" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 7px; background: #E0604A; color: #FFFFFF; font-size: 13px; font-weight: 800; text-decoration: none; padding: 10px 18px; border-radius: 10px; box-shadow: 0 4px 12px rgba(224,96,74,0.28);">
                ${IC_USERPLUS}ゲストとして参加登録
              </a>
            </div>`
        })
        .join("")

      wrap.style.display = "flex"
    } catch {
      // 取得に失敗しても、ページは壊れない（練習欄が非表示になるだけ）
    }
  })()
</script>

